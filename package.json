{
  "name": "browpilot",
  "private": true,
  "version": "0.2.2",
  "description": "Browser MCP for AI agents: Codex, Claude Code and Grok",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:package": "node --import tsx scripts/build-dist-package.mjs",
    "build:store": "node --import tsx scripts/build-store.mjs",
    "test": "vitest run",
    "test:integration": "RUN_BROWSER_TESTS=1 vitest run --config vitest.integration.config.ts",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "tsc --noEmit -p packages/shared/tsconfig.json && tsc --noEmit -p packages/broker/tsconfig.json && tsc --noEmit -p packages/mcp-server/tsconfig.json && npm run typecheck -w @browpilot/extension",
    "clean": "rm -rf packages/*/dist",
    "install:browser": "tsx scripts/install.ts",
    "uninstall:browser": "tsx scripts/uninstall.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "chrome-launcher": "^1.1.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "ws": "^8.18.0"
  }
}
