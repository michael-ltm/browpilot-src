{
  "manifest_version": 3,
  "name": "claude-browser",
  "version": "0.1.5",
  "description": "Codex-style stable browser control for Claude Code.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "claude-browser",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["debugger", "tabs", "history", "alarms", "scripting", "storage", "identity", "identity.email"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:*;"
  },
  "web_accessible_resources": [
    {
      "matches": ["<all_urls>"],
      "resources": ["cursor.js"]
    }
  ]
}
